{
  "project": "smartfactory-ai",
  "feature_version": "2026.10-smartfactory",
  "sampling_interval_s": 3.0,
  "window_size": 64,
  "step_size": 32,
  "feature_columns": [
    "sample_count",
    "temperature_mean",
    "temperature_std",
    "temperature_max",
    "temperature_min",
    "temperature_slope",
    "temperature_range",
    "vibration_mean",
    "vibration_std",
    "vibration_rms",
    "vibration_max",
    "vibration_min",
    "vibration_peak_to_peak",
    "vibration_crest_factor",
    "vibration_skew",
    "vibration_kurtosis",
    "vibration_zero_crossings",
    "current_mean",
    "current_std",
    "current_max",
    "current_slope",
    "rpm_mean",
    "rpm_std",
    "rpm_min",
    "rpm_range"
  ],
  "labels": [
    "anomaly",
    "degradation",
    "failure",
    "normal"
  ],
  "source_data": "data\\training_data.csv"
}